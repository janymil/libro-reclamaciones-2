node_modules
dist
.dev-server*.log
.DS_Store
server/public
vite.config.ts.*
*.tar.gz
# Environment files. Only the template is committed; everything else may hold
# credentials. `.env.*` also covers the temporary files used by the restore drill
# (`.env.scratch`) and by encrypted-env tools (dotenvx writes `.env.keys`).
.env
.env.*
!.env.example
.local-db
backups/
# Evidence attachments uploaded by consumers (Phase 1.1)
uploads/

# Playwright: reports, traces and the cached demo session (e2e/.auth/demo.json)
test-results/
playwright-report/
e2e/.auth/

# Captured test output pasted/redirected to a file (local only, never source)
final-run.txt

# VPS deployment secrets (Docker secret files, never committed)
/secrets/*.txt
/vps/secrets/
*.pem
*.key
*.crt

# Local exports of key material. The attachment key is copied to the password
# manager from a scratch file like this one; keeping it in the workspace is
# fine, committing it is not.
*_KEY*.txt
*_KEY*.json
*SECRET*.txt
*SECRET*.json
*TOKEN*.txt
*TOKEN*.json

# Raw video source files
Videos/
